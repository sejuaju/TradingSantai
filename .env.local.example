# ─────────────────────────────────────────────────────────────────────────────
# PLATFORM AUTH — Supabase (login/signup member Trading Santai)
# Dapatkan dari https://supabase.com/dashboard → Project Settings → API
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Vercel integration may use PUBLISHABLE_KEY instead of ANON_KEY — either works
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Saxo Bank API Configuration
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local to Git!

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — dari https://www.developer.saxo/ -> My Apps -> Create New App
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SAXO_APP_KEY=your_app_key_here
SAXO_APP_SECRET=your_app_secret_here

# Environment: "SIM" untuk sandbox/testing, "LIVE" untuk production
NEXT_PUBLIC_SAXO_ENVIRONMENT=SIM

# Redirect URI (harus sama persis dengan setting di Saxo Developer Portal)
NEXT_PUBLIC_SAXO_REDIRECT_URI=http://localhost:3001/auth/callback

# Session secret — generate dengan:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=generate_a_random_32_char_hex_string_here

# ─────────────────────────────────────────────────────────────────────────────
# DEMO / GUEST TOKEN — untuk market data publik tanpa login user
# ─────────────────────────────────────────────────────────────────────────────
# Pengunjung bisa lihat data market TANPA harus login akun Saxo pribadi.
# App menggunakan token milik pemilik app (kamu) sebagai "demo account".
#
# Cara mendapatkan refresh_token:
#   1. Jalankan app: npm run dev
#   2. Klik tombol LOGIN, login dengan akun Saxo SIM kamu
#   3. Setelah redirect ke /?instrument=EURUSD:
#      - Buka DevTools (F12) → Application → Local Storage → http://localhost:3001
#      - Cari key "saxo_tokens", copy nilai "refresh_token"
#   4. Paste di bawah ini, restart server (npm run dev)
#
# CATATAN: Refresh token berubah setiap kali dipakai.
#          Server akan log refresh token baru di console — update nilai ini
#          dan restart server jika app pernah di-restart.
#
SAXO_DEMO_REFRESH_TOKEN=your_demo_refresh_token_here
